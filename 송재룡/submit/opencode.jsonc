{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "share": "manual",
  "permission": {
    "*": "allow",
    "external_directory": "deny",
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "rm *": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "kubectl *": "deny",
      "terraform *": "deny",
      "docker system prune*": "deny"
    }
  }
}
